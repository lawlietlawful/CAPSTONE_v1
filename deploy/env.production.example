# Production settings for student-referral-system on a Linux server.
#
# Copy to student-referral-system/.env on the server (never commit the copy):
#   cp ../deploy/env.production.example .env && php artisan key:generate
# Replace every value in <angle brackets>. Then run: php artisan deploy:check

APP_NAME="Student Referral System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<portal.your-school.edu.ph>
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Its own MySQL user with rights to this one database — not root.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=student_referral_db
DB_USERNAME=referral_app
DB_PASSWORD=<a long random password>

# php artisan db:backup runs hourly from the scheduler and keeps one a day.
DB_DUMP_BINARY=mysqldump
BACKUP_KEEP=14

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Email isn't used for sign-in (passwords are reset at the Guidance Office).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@<your-school.edu.ph>"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ── Security / integrations ───────────────────────────────────────────────────
# Mobile sign-ins last 30 days.
SANCTUM_EXPIRATION=43200

# The Teacher and Student portals are served from the same address under
# /teacher/ and /student/, so this is just the portal's own origin.
CORS_ALLOWED_ORIGINS=https://<portal.your-school.edu.ph>

# The ML engine stays on 127.0.0.1 (never opened in the firewall). Use the SAME
# long random value here and in /etc/referral/ml-engine.env.
ML_ENGINE_URL=http://127.0.0.1:8001
ML_ENGINE_KEY=<a long random key>

ML_RETRAIN_ENABLED=false

# SMS stays simulated until an admin enters a Semaphore API key in the web
# app's Settings. Only do that once the school has approved texting parents.
